# NextGen Learning Site Environment Configuration
# Duplicate this file to .env and fill in your actual Supabase credentials

# Supabase Project Credentials (Frontend only needs URL and Anon Key)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Phone Authentication Mode: "simple" (default) or "otp"
# - "simple": No SMS needed. Accounts use 91XXXXXXXXXX@phone.nextgen.local internally.
# - "otp": Supabase Native Phone Auth with SMS OTP confirmation (requires SMS provider configured in Supabase).
VITE_PHONE_AUTH_MODE=simple
